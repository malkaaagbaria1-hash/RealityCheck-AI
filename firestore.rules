rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function order(id)      { return get(/databases/$(database)/documents/orders/$(id)).data; }
    function orderAfter(id) { return getAfter(/databases/$(database)/documents/orders/$(id)).data; }

    match /orders/{id} {
      // كل المستخدمين بيشوفوا الطلبات (بدون أرقام تلفون)
      allow read: if request.auth != null;

      // المرسل بينشر طلب جديد باسمه، وحالته "open"
      allow create: if request.auth != null
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.courier == null
        && !('phone' in request.resource.data);

      allow update: if request.auth != null && (
        // شليح بياخد طلب لسا مفتوح (أول واحد بس)
        (resource.data.status == 'open'
          && request.resource.data.status == 'taken'
          && request.resource.data.courier == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'courier', 'courierName', 'takenAt']))
        ||
        // الشليح اللي أخذ الطلب بيحدّث: استلمت ← وصّلت
        (resource.data.courier == request.auth.uid
          && ((resource.data.status == 'taken' && request.resource.data.status == 'picked')
              || (resource.data.status == 'picked' && request.resource.data.status == 'delivered'))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'pickedAt', 'deliveredAt']))
      );

      // المرسل بيحذف طلبه إذا لسا ما انقبل أو بعد ما انوصل
      allow delete: if request.auth != null
        && resource.data.by == request.auth.uid
        && resource.data.status in ['open', 'delivered'];

      // أرقام التلفون: بس المرسل والشليح اللي أخذ الطلب بيشوفوها
      match /private/{doc} {
        allow read: if request.auth != null
          && (order(id).by == request.auth.uid || order(id).courier == request.auth.uid);
        allow create: if request.auth != null && orderAfter(id).by == request.auth.uid;
        allow update: if request.auth != null
          && orderAfter(id).courier == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courierPhone']);
        allow delete: if request.auth != null && order(id).by == request.auth.uid;
      }
    }

    // توكنات الإشعارات: كل واحد بيكتب تبعه بس، ومحدش بيقرأها (السيرفر بس)
    match /tokens/{uid} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
